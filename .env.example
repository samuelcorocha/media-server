# Copie para .env e ajuste conforme sua máquina:  cp .env.example .env
# Descubra seu PUID/PGID com:  id -u  /  id -g

PUID=1000
PGID=1000
TZ=America/Sao_Paulo

# Caminhos (relativos a este diretório). Aponte ROOT_PATH para um HD maior se quiser.
ROOT_PATH=./data
CONFIG_PATH=./config

# Portas das WebUIs
JELLYFIN_PORT=8096
SONARR_PORT=8989
RADARR_PORT=7878
PROWLARR_PORT=9696
QBIT_WEBUI_PORT=8080
JELLYSEERR_PORT=5055
FLARESOLVERR_PORT=8191
BAZARR_PORT=6767
